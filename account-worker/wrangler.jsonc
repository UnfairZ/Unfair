{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ua-account-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../site",
    "binding": "SITE",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "SITE_ORIGIN": "",
    "DISCORD_CLIENT_ID": ""
  },
  "ratelimits": [{
    "name": "AUTH_LIMIT",
    "namespace_id": "19742601",
    "simple": { "limit": 20, "period": 60 }
  }],
  "d1_databases": [{
    "binding": "ACCOUNTS",
    "database_name": "ua-site-accounts",
    "database_id": "REPLACE_WITH_NEW_UA_ACCOUNT_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["23 4 * * *"] }
}
